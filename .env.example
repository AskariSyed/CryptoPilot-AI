# ==============================================================================
# CryptoPilot AI - Environment Configuration Example
# ==============================================================================

# Application Environment (development, testing, production)
CRYPTOPILOT_ENV=development
LOG_LEVEL=INFO
DEBUG=true

# Operational Trading Mode
# IMPORTANT: Live trading is strictly prohibited in this initial release.
TRADING_MODE=paper
ENABLE_LIVE_TRADING=false

# Account Environment Configuration
# Options: 'small_account' ($30 initial capital, $10/mo deposit) or 'research' ($10,000 virtual balance)
ACCOUNT_TYPE=small_account
INITIAL_CAPITAL=30.0
MONTHLY_CONTRIBUTION=10.0
CURRENCY=USDT

# Risk Management Parameters
MAX_POSITION_ALLOCATION_PCT=0.30
MAX_RISK_PER_TRADE_PCT=0.01
DAILY_LOSS_LIMIT_PCT=0.02
MAX_CONCURRENT_POSITIONS=1

# Public Market Data Configuration (CCXT)
EXCHANGE_ID=binance
DEFAULT_SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT
DEFAULT_TIMEFRAMES=1m,15m,1h,4h
ENABLE_RATE_LIMIT=true
REQUEST_TIMEOUT_MS=10000

# Database Storage Configuration
# SQLite (Local Development & Testing)
DATABASE_URL=sqlite+aiosqlite:///./data/cryptopilot_dev.db
# PostgreSQL (Production Docker Deployment)
# DATABASE_URL=postgresql+asyncpg://cryptopilot:secretpass@localhost:5432/cryptopilot

# REST API & Security
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=change_me_to_a_secure_random_string_in_production
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Sentiment Provider Configuration (Optional / Mocked by default)
SENTIMENT_PROVIDER=mock
NEWS_API_KEY=
FINBERT_MODEL_NAME=ProsusAI/finbert
